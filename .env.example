# UrbanBreathe needs no API keys or secrets. All variables are optional.

# "demo" serves deterministic, clearly labelled DEMO fixtures instead of calling
# Open-Meteo. Leave unset (or any other value) for live modelled data.
DATA_MODE=

# Port for the local API server (`npm run server`). The Vite dev proxy expects 3001.
PORT=3001

# Comma-separated browser origins allowed to call the API cross-origin.
# Leave empty: the UI is served from the same origin (Vercel) or via the Vite proxy.
# Example: CORS_ORIGINS=https://example.org,https://dashboard.example.org
CORS_ORIGINS=
